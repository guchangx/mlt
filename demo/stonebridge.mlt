<?xml version="1.0" encoding="utf-8"?>
<mlt>
  <!-- Profile: adjust to your desired fps/size -->
  <profile frame_rate_num="30" frame_rate_den="1" width="1920" height="1080" progressive="1"/>

  <!-- Source clips -->
  <producer id="clip_0">
    <property name="resource">/workspaces/mlt/media/scenery.mp4</property>
  </producer>

  <producer id="clip_1">
    <property name="resource">/workspaces/mlt/media/DJI_20260211111507_0019_V_1770779704a.MP4</property>
  </producer>
  
  <producer id="clip_2">
    <property name="resource">/workspaces/mlt/media/DJI_20260211111629_0021_V_1770779704a.MP4</property>
  </producer>

  <producer id="clip_3">
    <property name="resource">/workspaces/mlt/media/DJI_20260211111705_0022_V_1770779704a.MP4</property>
  </producer>

  <producer id="clip_4">
    <property name="resource">/workspaces/mlt/media/DJI_20260211111541_0020_V_1770779704a.MP4</property>
  </producer>

  <producer id="clip_5">
    <property name="resource">/workspaces/mlt/media/DJI_20260211111758_0023_V_1770779704a.MP4</property>
  </producer>

  <producer id="music">
    <property name="resource">/workspaces/mlt/media/music.mp3</property>
  </producer>

  <playlist id="playlist0">
    <entry producer="clip_0" in="0" out="130"/>
  </playlist>

  <playlist id="playlist1">
    <blank length="100"/>
    <entry producer="clip_1" in="240" out="395"/>
  </playlist>

  <playlist id="playlist2">
    <blank length="225"/>
    <entry producer="clip_2" in="154" out="308"/>
  </playlist>

  <playlist id="playlist3">
    <blank length="349"/>
    <entry producer="clip_3" in="456" out="668"/>
    <filter in="349" out="379">
      <property name="mlt_service">shape</property>
      <property name="resource">round_rectangle.pbm</property>
      <property name="use_luminance">1</property>
      <property name="use_mix">0</property>
    </filter>
  </playlist>

  <chain id="chain0" title="heroic moment" in="00:00:00.000" out="00:00:06.000">
    <property name="mlt_service">avformat-novalidate</property>
    <property name="resource">/workspaces/mlt/media/DJI_20260211111541_0020_V_1770779704a.MP4</property>
    <property name="audio_index">-1</property>
    <property name="video_index">0</property>
    
    <link id="link0">
      <property name="mlt_service">timeremap</property>
      <property name="shotcut:filter">speedForward</property>
      <property name="speed_map">0$=1;60$=5.4;80=0.3;90$=0.3;110$=5.4;170=1</property>
      <property name="image_mode">nearest</property>
      <property name="pitch">0</property>
      <property name="speed">1</property>
    </link>
  </chain>

  <playlist id="playlist4">
    <blank length="532"/>
    <entry producer="chain0"/>
  </playlist>


  <chain id="chain1" title="heroic moment" in="00:00:00.000" out="00:00:11.000">
    <property name="mlt_service">avformat-novalidate</property>
    <property name="resource">/workspaces/mlt/media/DJI_20260211111758_0023_V_1770779704a.MP4</property>
    <property name="audio_index">-1</property>
    <property name="video_index">0</property>
    
    <link id="link0">
      <property name="mlt_service">timeremap</property>
      <property name="shotcut:filter">speedForward</property>
      <property name="speed_map">0$=1;60$=5.0;80=0.3;90$=0.3;110$=5.0;170=1</property>
      <property name="image_mode">nearest</property>
      <property name="pitch">0</property>
      <property name="speed">1</property>
    </link>
  </chain>

  <playlist id="playlist5">
    <blank length="678"/>
    <entry producer="chain1"/>  
  </playlist>

  <playlist id="playlist_music">
    <entry producer="music" in="0" out="1008"/>
  </playlist>

  <tractor id="main" in="0" out="1008">
    <multitrack>
      <track producer="playlist0"/>
      <track producer="playlist1"/>
      <track producer="playlist2"/>
      <track producer="playlist3"/>
      <track producer="playlist4"/>
      <track producer="playlist5"/>
      <track producer="playlist_music" hide="video"/>
    </multitrack>

    <filter in="0" out="29">
      <property name="mlt_service">brightness</property>
      <property name="level">0=0;-1=1</property>
    </filter>

    <!-- transition: left-to-right wipe on tracka->trackb overlap in-out -->
    <transition id="transition_0" in="100" out="130" a_track="1" b_track="0">
      <property name="mlt_service">luma</property>
      <property name="resource">luma_lr.pgm</property>
      <property name="softness">0</property>
      <property name="reverse">1</property>
    </transition>

    <transition id="transition_1" in="225" out="254" a_track="1" b_track="2">
      <property name="mlt_service">luma</property>
    </transition>

    <transition id="transition_2" in="349" out="379" a_track="2" b_track="3">
      <property name="mlt_service">affine</property>
      <property name="rect">0=40%/40%:20%x20%:30%; -1=10%/10%:80%x80%:100%</property>
      <property name="fill">1</property>
      <property name="distort">0</property>
      <property name="b_alpha">1</property>
      <property name="threads">0</property>
    </transition>

    <transition id="transition_3" in="532" out="561" a_track="3" b_track="4">
      <property name="mlt_service">frei0r.darken</property>
    </transition>

    <transition id="transition_4" in="678" out="708" a_track="4" b_track="5">
      <property name="mlt_service">luma</property>
    </transition>

    <filter in="900" out="1008">
      <property name="mlt_service">box_blur</property>
      <property name="hradius">0=0;-1=10</property>
      <property name="vradius">0=0;-1=10</property>
      <property name="preserve_alpha">0</property>
    </filter>
    <filter in="900" out="1008">
      <property name="mlt_service">box_blur</property>
      <property name="hradius">0=0;-1=10</property>
      <property name="vradius">0=0;-1=10</property>
      <property name="preserve_alpha">0</property>
    </filter>
    <filter in="900" out="1008">
      <property name="mlt_service">box_blur</property>
      <property name="hradius">0=0;-1=10</property>
      <property name="vradius">0=0;-1=10</property>
      <property name="preserve_alpha">0</property>
    </filter>

    <!-- Last 1s text fade-in -->
    <filter in="900" out="1008">
      <property name="mlt_service">dynamictext</property>
      <property name="argument">走过石桥，喧嚣还给城市，宁静留给自己。</property>
      <property name="family">simfang</property>
      <property name="size">68</property>
      <property name="weight">400</property>
      <property name="fgcolour">0xffffffff</property>
      <property name="bgcolour">0x00000000</property>
      <property name="geometry">0=0%/0%:100%x100%:0%; -1=0%/0%:100%x100%:100%</property>
      <property name="halign">centre</property>
      <property name="valign">middle</property>
      <!-- Keep opacity animation for qtext backend compatibility. -->
      <property name="opacity">0=0;-1=1</property>
    </filter>

  </tractor>
</mlt>