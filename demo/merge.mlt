<?xml version="1.0" encoding="utf-8"?>
<mlt>
  <!-- Profile: adjust to your desired fps/size -->
  <profile frame_rate_num="30" frame_rate_den="1" width="1920" height="1080" progressive="1"/>

  <!-- Source clips -->
  <producer id="clip_a">
    <property name="resource">/workspaces/mlt/media/test1.MP4</property>
  </producer>

  <producer id="clip_b">
    <property name="resource">/workspaces/mlt/media/test4.MP4</property>
  </producer>
  
  <producer id="clip_c">
    <property name="resource">/workspaces/mlt/media/test5.MP4</property>
  </producer>

  <!-- Track 0 playlist -->
  <!-- Track 0: extend to frame 179 so it overlaps 30 frames with track 1 (150-179) -->
  <playlist id="playlist0">
    <entry producer="clip_a" in="0" out="179"/>
  </playlist>

  <!-- Track 1 playlist -->
  <!-- Track 1: start at frame 150 (after 150-frame blank), giving 30-frame overlap with track 0 -->
  <playlist id="playlist1">
    <blank length="150"/>
    <entry producer="clip_b" in="0" out="249"/>
  </playlist>

  <playlist id="playlist2">
    <blank length="370"/>
    <entry producer="clip_c" in="0" out="150"/>
    <filter in="370" out="399">
      <property name="mlt_service">shape</property>
      <property name="resource">round_rectangle.pbm</property>
      <property name="use_luminance">1</property>
      <property name="use_mix">0</property>
    </filter>
  </playlist>

  <tractor id="main" in="0" out="520">
    <multitrack>
      <track producer="playlist0"/>
      <track producer="playlist1"/>
      <track producer="playlist2"/>
    </multitrack>

    <filter in="0" out="29">
      <property name="mlt_service">brightness</property>
      <property name="level">0=0;-1=1</property>
    </filter>

    <transition id="transition0" in="150" out="179" a_track="0" b_track="1">
      <property name="mlt_service">luma</property>
    </transition>

    <!-- second transition: left-to-right wipe on track1->track2 overlap 370-399 -->
    <!--transition id="transition1" in="370" out="399" a_track="1" b_track="2">
      <property name="mlt_service">luma</property>
      <property name="resource">luma_lr.pgm</property>
      <property name="softness">0</property>
      <property name="reverse">0</property>
    </transition -->

    <transition id="transition1" in="370" out="399" a_track="1" b_track="2">
      <property name="mlt_service">affine</property>
      <property name="rect">0=40%/40%:20%x20%:10%; -1=30%/30%:40%x40%:100%</property>
      <property name="fill">1</property>
      <property name="distort">0</property>
      <property name="b_alpha">1</property>
      <property name="threads">0</property>
    </transition>

    <!-- Last 1s: progressive blur from clear to blurred -->
    <filter in="490" out="520">
      <property name="mlt_service">box_blur</property>
      <property name="hradius">0=0;-1=5</property>
      <property name="vradius">0=0;-1=5</property>
      <property name="preserve_alpha">0</property>
    </filter>
    <filter in="490" out="520">
      <property name="mlt_service">box_blur</property>
      <property name="hradius">0=0;-1=5</property>
      <property name="vradius">0=0;-1=5</property>
      <property name="preserve_alpha">0</property>
    </filter>
    <filter in="490" out="520">
      <property name="mlt_service">box_blur</property>
      <property name="hradius">0=0;-1=5</property>
      <property name="vradius">0=0;-1=5</property>
      <property name="preserve_alpha">0</property>
    </filter>

    <!-- Last 1s text fade-in (30fps, 490-520) -->
    <filter in="490" out="520">
      <property name="mlt_service">dynamictext</property>
      <property name="argument">走过石桥，留下宁静。</property>
      <property name="family">simfang</property>
      <property name="size">68</property>
      <property name="weight">400</property>
      <property name="fgcolour">0xffffffff</property>
      <property name="bgcolour">0x00000000</property>
      <!-- Animate rect.o (the 5th geometry value) for fade-in so it works even
           when dynamictext falls back to the text filter backend. -->
      <property name="geometry">0=0%/0%:100%x100%:0%; -1=0%/0%:100%x100%:100%</property>
      <property name="halign">centre</property>
      <property name="valign">middle</property>
      <!-- Keep opacity animation for qtext backend compatibility. -->
      <property name="opacity">0=0;-1=1</property>
    </filter>
  </tractor>
</mlt>